; Trimmed subset of RFC 9052 (COSE) needed for the COSE_Sign1 / EAT
; `;# constrain` fixture — just enough for COSE_Sign1 to resolve.

label = int / tstr
values = any

Headers = (
    protected : empty_or_serialized_map,
    unprotected : header_map
)

header_map = {
    Generic_Headers,
    * label => values
}

empty_or_serialized_map = bstr .cbor header_map / bstr .size 0

Generic_Headers = (
    ? 1 => int / tstr,
    ? 2 => [+label],
    ? 3 => tstr / int,
    ? 4 => bstr,
    ? ( 5 => bstr //
        6 => bstr )
)

COSE_Sign1 = [
    Headers,
    payload : bstr / nil,
    signature : bstr
]
